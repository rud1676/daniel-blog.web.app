{
  "hosting": {
    "target": "blog",
    "public": "dist",
    "cleanUrls": true,
    "headers": [
      {
        "source": "/_astro/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "**/*.md",
        "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
      }
    ]
  }
}
