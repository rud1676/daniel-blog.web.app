---
import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { getPublishedPosts, getRelatedPosts, readingMinutes, type Post } from '../../lib/posts';

export async function getStaticPaths() {
	// draft는 여기서 걸러지므로 경로 자체가 생성되지 않는다
	const posts = await getPublishedPosts();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post, related: getRelatedPosts(posts, post) },
	}));
}

interface Props {
	post: Post;
	related: Post[];
}

const { post, related } = Astro.props;
const { Content, headings } = await render(post);
---

<PostLayout post={post} headings={headings} related={related} minutes={readingMinutes(post.body)}>
	<Content />
</PostLayout>
