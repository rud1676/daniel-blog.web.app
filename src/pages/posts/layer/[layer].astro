---
import PostsIndex from '../../../components/PostsIndex.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import type { Layer } from '../../../lib/layers';
import { getLayerCounts, getPublishedPosts } from '../../../lib/posts';

// 글이 1편 이상인 레이어만 페이지를 만든다. 빈 레이어 주소는 404가 된다.
export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	return getLayerCounts(posts).map(({ layer }) => ({ params: { layer }, props: { layer, posts } }));
}

interface Props {
	layer: Layer;
	posts: Awaited<ReturnType<typeof getPublishedPosts>>;
}

const { layer, posts } = Astro.props;
---

<BaseLayout title={`${layer} 레이어를 거친 글`} description={`문제가 ${layer} 영역을 거쳐 간 글 목록.`}>
	<PostsIndex all={posts} layer={layer} />
</BaseLayout>
