---
// 셸 문법의 404. Firebase Hosting이 dist/404.html을 없는 주소에 자동으로 보여 준다.
// JS 0 — 그래서 실제 요청 주소를 넣지 않고 "요청한 주소"라는 고정 문구를 쓴다 (plan D8).
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404" description="찾는 글이 없다.">
	<pre class="nf"><span class="p">$</span> cd 요청한-주소
<span class="w">cd: no such file or directory:</span> 요청한-주소

<span class="dim"># 주소가 바뀌었거나 아직 없는 글이에요.</span>
<span class="p">$</span> <a href="/">open ~</a>      <span class="dim"># 홈으로</span>
<span class="p">$</span> <a href="/posts">ls /posts</a>   <span class="dim"># 전체 글 보기</span>
<span class="p">$</span> <span class="cur" aria-hidden="true">▌</span></pre>
</BaseLayout>

<style>
	.nf {
		margin: 28px 0 120px;
		color: var(--tx);
		font: 15px/2 var(--mono);
		white-space: pre-wrap;
	}
	.p {
		color: var(--ok);
	}
	.w {
		color: var(--warn);
	}
	a {
		color: var(--acc);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.cur {
		color: var(--acc);
		animation: blink 1s steps(2) infinite;
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.cur {
			animation: none;
		}
	}
	@media (max-width: 720px) {
		.nf {
			font-size: 13px;
		}
	}
</style>
