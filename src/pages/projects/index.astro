---
// /projects — 포스터 카드 슬라이드 (blog-design-2 B안). JS 0.
// 넘기기 = CSS scroll-snap. 트랙에 tabindex="0"이라 포커스 후 ←/→ 가 브라우저 기본 스크롤로 동작한다.
// 가운데 강조(스크롤 연동 애니메이션)·점(::scroll-marker)은 지원 브라우저에서만 — 없으면 넘기기만 된다.
import ProjectCard from '../../components/projects/ProjectCard.astro';
import ViewTabs from '../../components/projects/ViewTabs.astro';
import { projects } from '../../data/projects';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="projects" description="Daniel의 개인 프로젝트 — MLB 데이터 서비스, 이 블로그, dagent.">
	<p class="crumb mono">
		<span class="p">$</span> ls ~/projects <span class="dim"># ← → 또는 스와이프로 넘기기</span>
	</p>
	<h1 class="sr-only">프로젝트</h1>
	<ul class="track" tabindex="0" aria-label="프로젝트 카드 — 좌우로 넘기기">
		{
			projects.map((project) => (
				<li class="slide">
					<ProjectCard project={project} />
				</li>
			))
		}
	</ul>
	<ViewTabs current="slides" />
</BaseLayout>

<style>
	.crumb {
		margin: 0 0 14px;
		color: var(--tx);
		font-size: 13px;
	}
	.crumb .p {
		margin-right: 6px;
		color: var(--ok);
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	.track {
		--w: min(600px, 100%);
		display: flex;
		align-items: start; /* 한 카드를 펼쳐도 옆 카드 높이는 그대로 */
		gap: 20px;
		margin: 0;
		/* 첫 카드·마지막 카드도 가운데에 올 수 있게 양옆 여백 */
		padding: 18px calc((100% - var(--w)) / 2) 8px;
		overflow-x: auto;
		list-style: none;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
		overscroll-behavior-x: contain;
	}
	.track::-webkit-scrollbar {
		display: none;
	}
	.track:focus-visible {
		outline: 1px solid var(--acc);
		outline-offset: 4px;
		border-radius: 10px;
	}
	.slide {
		flex: 0 0 var(--w);
		scroll-snap-align: center;
	}
	.slide :global(.pb) {
		transition: border-color 0.2s;
	}

	/* 가운데 하나만 크게 — 트랙 안에서 카드 위치에 따라 (JS 0, 지원 브라우저만) */
	@supports (animation-timeline: view()) {
		@media (prefers-reduced-motion: no-preference) {
			.slide {
				animation: focus linear both;
			}
			/* 따로 둔다 — 한 규칙에 있으면 CSS 압축기가 animation 단축 속성에 합쳐서 브라우저가 무시한다 */
			.track > .slide {
				animation-timeline: view(inline);
			}
			@keyframes focus {
				0%,
				100% {
					opacity: 0.35;
					scale: 0.92;
				}
				50% {
					opacity: 1;
					scale: 1;
				}
			}
		}
	}

	/* 점 표시 — ::scroll-marker 지원 브라우저만 */
	@supports selector(::scroll-marker) {
		.track {
			scroll-marker-group: after;
		}
		.track::scroll-marker-group {
			display: flex;
			justify-content: center;
			gap: 8px;
			margin-top: 14px;
		}
		.slide::scroll-marker {
			content: '';
			width: 7px;
			height: 7px;
			border-radius: 4px;
			background: var(--dot);
		}
		.slide::scroll-marker:target-current {
			width: 22px;
			background: var(--acc);
		}
	}

	@media (max-width: 720px) {
		.track {
			--w: 100%;
			gap: 12px;
		}
	}
</style>
