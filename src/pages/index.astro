---
import Hero from '../components/Hero.astro';
import PostTable from '../components/PostTable.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getGitLog } from '../lib/gitlog';
import { getHomePosts, getPublishedPosts } from '../lib/posts';

// 홈은 "누구인가" + 이 사이트의 git log(히어로) + 글 몇 편(대표 + 최신). 전체 목록은 /posts.
const posts = await getPublishedPosts();
const homePosts = getHomePosts(posts);
const log = await getGitLog();
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<Hero log={log} />

	<section aria-labelledby="home-posts">
		<h2 id="home-posts" class="sec">대표 글 · 최근 글</h2>
		<PostTable posts={homePosts} />
		{
			posts.length > 0 && (
				<p class="more">
					<a href="/posts">전체 글 {posts.length}편 보기 →</a>
				</p>
			)
		}
	</section>
</BaseLayout>

<style>
	.sec {
		margin: 0 0 12px;
		color: var(--hi);
		font: 600 15px var(--sans);
	}
	.more {
		margin: 14px 0 0;
		font: 14px var(--mono);
	}
	.more a:hover {
		color: var(--acc);
	}
</style>
