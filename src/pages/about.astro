---
// `kubectl describe developer/daniel` 형식의 소개. 경력은 Events 타임라인, 프로젝트는 pod 카드. JS 0.
// 내용은 src/data/about.ts 에 있다.
import { GITHUB_URL, RESUME_URL } from '../consts';
import { describe, events, projects } from '../data/about';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="about" description="Daniel — 문제를 따라 레이어를 넘는 개발자. 경력과 프로젝트.">
	<h1 class="cmd mono"><span class="p">$</span> kubectl describe developer/<em>daniel</em></h1>

	<dl class="desc">
		<dt>Name</dt>
		<dd>{describe.name}</dd>
		<dt>Role</dt>
		<dd>{describe.role}</dd>
		<dt>Approach</dt>
		<dd>{describe.approach}</dd>
		<dt>Strengths</dt>
		<dd>{describe.strengths}</dd>
		<dt>Contact</dt>
		<dd><a href={`mailto:${describe.contact}`}>{describe.contact}</a></dd>
		<dt>Links</dt>
		<dd class="links">
			<a href={GITHUB_URL} target="_blank" rel="noopener">github</a>
			{RESUME_URL && <a href={RESUME_URL} target="_blank" rel="noopener">resume</a>}
			<a href="/rss.xml">rss</a>
		</dd>
	</dl>

	<h2 class="mono"><span class="p">$</span> Events:</h2>
	<div class="ev" role="list">
		{
			events.map((e) => (
				<div class="evr" role="listitem">
					<span class="t mono">{e.when}</span>
					<span class:list={['ty mono', { w: e.type === 'Warning' }]}>{e.type}</span>
					<span class="re mono">{e.reason}</span>
					<div>
						<b>{e.title}</b>
						{e.detail && <span class="m">{e.detail}</span>}
					</div>
				</div>
			))
		}
	</div>

	<h2 class="mono"><span class="p">$</span> Projects:</h2>
	<div class="pods">
		{
			projects.map((p) => {
				const Tag = p.href ? 'a' : 'div';
				return (
					<Tag class="pod" href={p.href} target={p.href?.startsWith('http') ? '_blank' : undefined} rel={p.href ? 'noopener' : undefined}>
						<div class="n mono">
							<span class:list={['led', { off: !p.live }]} aria-label={p.live ? '운영 중' : '준비 중'} />
							{p.name}
						</div>
						<div>{p.summary}</div>
						<div class="st mono dim">{p.stack}</div>
					</Tag>
				);
			})
		}
	</div>
</BaseLayout>

<style>
	.cmd {
		margin: 0 0 10px;
		color: var(--dim);
		font-size: 13px;
		font-weight: 400;
	}
	.cmd .p,
	h2 .p {
		margin-right: 6px;
		color: var(--ok);
	}
	.cmd em {
		color: var(--hi);
		font-style: normal;
	}
	.desc {
		display: grid;
		grid-template-columns: 130px 1fr;
		gap: 6px 16px;
		margin: 0;
		font-size: 15px;
	}
	.desc dt {
		padding-top: 2px;
		color: var(--acc);
		font: 13px var(--mono);
	}
	.desc dd {
		margin: 0;
		color: var(--tx);
	}
	.desc a {
		color: var(--front);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.links {
		display: flex;
		gap: 14px;
		font: 13px var(--mono);
	}
	h2 {
		margin: 30px 0 10px;
		color: var(--dim);
		font-size: 13px;
		font-weight: 400;
	}
	.ev {
		padding: 6px 0;
		border: 1px solid var(--line);
		border-radius: 8px;
		background: var(--panel);
	}
	.evr {
		display: grid;
		grid-template-columns: 78px 86px 110px 1fr;
		gap: 14px;
		padding: 11px 18px;
		border-bottom: 1px solid var(--line);
		font-size: 14px;
	}
	.evr:last-child {
		border: 0;
	}
	.t {
		color: var(--dim);
		font-size: 13px;
	}
	.ty {
		color: var(--ok);
		font-size: 13px;
	}
	.ty.w {
		color: var(--warn);
	}
	.re {
		color: var(--hi);
		font-size: 13px;
	}
	.evr b {
		color: var(--hi);
		font-weight: 600;
	}
	.m {
		display: block;
		color: var(--dim);
		font-size: 13px;
	}
	.pods {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 12px;
	}
	.pod {
		padding: 12px 14px;
		border: 1px solid var(--line);
		border-radius: 6px;
		background: var(--panel);
		font-size: 14px;
	}
	a.pod:hover {
		border-color: var(--acc);
	}
	.pod .n {
		margin-bottom: 4px;
		color: var(--hi);
		font-size: 13px;
	}
	.pod .st {
		margin-top: 6px;
		font-size: 12px;
	}
	.led {
		display: inline-block;
		width: 8px;
		height: 8px;
		margin-right: 8px;
		border-radius: 50%;
		background: var(--ok);
		box-shadow: 0 0 8px var(--ok);
	}
	.led.off {
		background: var(--dot);
		box-shadow: none;
	}
	@media (max-width: 720px) {
		.desc {
			grid-template-columns: 1fr;
			gap: 0;
		}
		.desc dd {
			margin-bottom: 10px;
		}
		.evr {
			grid-template-columns: 66px 1fr;
			gap: 4px 10px;
		}
		.ty {
			display: none;
		}
		.re {
			grid-column: 2;
		}
		.evr > div {
			grid-column: 1 / 3;
		}
		.pods {
			grid-template-columns: 1fr;
		}
	}
</style>
