---
// `whoami` — 내 정보만. 경력 타임라인은 두지 않고, 프로젝트는 /projects 로. JS 0.
// 내용은 src/data/about.ts 에 있다.
import { GITHUB_URL } from '../consts';
import { describe } from '../data/about';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="about" description="Daniel — 인프라를 주로 다루는, 레이어를 넘나드는 개발자.">
	<p class="crumb mono"><span class="p">$</span> whoami</p>
	<section class="ab">
		<h1>{describe.name}</h1>
		<p class="role">{describe.role}</p>
		<p class="appr">{describe.approach}</p>
		<dl class="kv mono">
			<dt>Contact</dt>
			<dd><a href={`mailto:${describe.contact}`}>{describe.contact}</a></dd>
			<dt>Links</dt>
			<dd>
				<a href={GITHUB_URL} target="_blank" rel="noopener">github</a> · <a href="/rss.xml">rss</a>
			</dd>
			{/* projects는 임시로 숨김(2026-11-05) — 다시 열 때 아래 두 줄을 되살린다
			<dt>Projects</dt>
			<dd><a href="/projects">kubectl get pods -n projects →</a></dd>
			*/}
		</dl>
	</section>
</BaseLayout>

<style>
	.crumb {
		margin: 0 0 14px;
		color: var(--tx);
		font-size: 13px;
	}
	.crumb .p {
		margin-right: 6px;
		color: var(--ok);
	}
	h1 {
		margin: 0 0 10px;
		color: var(--hi);
		font-size: 34px;
	}
	.role {
		margin: 0 0 8px;
		color: var(--hi);
		font-size: 18px;
	}
	.appr {
		margin: 0 0 22px;
		color: var(--body);
	}
	.kv {
		display: grid;
		grid-template-columns: 90px 1fr;
		gap: 6px 12px;
		margin: 0;
		font-size: 14px;
	}
	.kv dt {
		color: var(--acc);
	}
	.kv dd {
		margin: 0;
		color: var(--dim);
	}
	.kv a {
		color: var(--front);
	}
	.kv a:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	@media (max-width: 720px) {
		h1 {
			font-size: 28px;
		}
		.role {
			font-size: 16px;
		}
		.kv {
			grid-template-columns: 76px 1fr;
			font-size: 13px;
		}
	}
</style>
