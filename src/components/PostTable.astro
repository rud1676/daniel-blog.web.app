---
import { formatPubDate } from '../lib/age';
import type { Post } from '../lib/posts';
import { formatViews, getViews } from '../lib/views';
import LayerRoute from './LayerRoute.astro';

/**
 * 글 표: NAME / CATEGORY / LAYERS / STANCE / DATE(+ 아래 views). 행 전체가 글 링크다.
 * views는 빌드 때 BigQuery에서 센 값(lib/views.ts) — 집계 안 한 빌드거나 0이면 안 보인다.
 * 홈·/posts·레이어 필터·글 끝 "같은 레이어 글"이 같이 쓴다. JS 0.
 * 720px 이하에선 카드형(제목·DATE / 레이어 / 관점)으로 다시 배치한다.
 */
interface Props {
	posts: Post[];
	/** 글이 없을 때 보일 문장 */
	empty?: string;
	/** 표 머리글(NAME LAYERS …)을 숨긴다 — 글 끝 관련 글처럼 문맥상 뻔할 때 */
	headless?: boolean;
	/** LAYERS 칸을 TAGS로 — 레이어를 달지 않는 카테고리(study) 탭에서만. 제목 아래 태그 줄은 중복이라 뺀다 */
	tagColumn?: boolean;
}

const { posts, empty = '아직 발행한 글이 없다.', headless = false, tagColumn = false } = Astro.props;
const views = await getViews();
const hasViews = views.updatedAt !== null;
---

{
	posts.length === 0 ? (
		<p class="empty dim mono">{empty}</p>
	) : (
		<div class="tbl" role="list">
			{!headless && (
				<div class="tr th" aria-hidden="true">
					<div>NAME</div>
					<div>CATEGORY</div>
					<div>{tagColumn ? 'TAGS' : 'LAYERS'}</div>
					<div>STANCE</div>
					<div class="age">DATE{hasViews && <span class="vw">VIEWS</span>}</div>
				</div>
			)}
			{posts.map((post) => (
				<a class="tr" href={`/posts/${post.id}/`} role="listitem">
					<div class="name">
						{post.data.pinned && <span class="pin">PINNED</span>}
						{post.data.title}
						{!tagColumn && post.data.tags.length > 0 && (
							<small>{post.data.tags.slice(0, 2).map((tag) => `#${tag}`).join(' ')}</small>
						)}
					</div>
					<div class="meta">
						<div class="cat">{post.data.category}</div>
						<div class="route">
							{tagColumn ? (
								<span class="tags">{post.data.tags.map((tag) => <span class="tg">#{tag}</span>)}</span>
							) : (
								post.data.layers && <LayerRoute layers={post.data.layers} />
							)}
						</div>
					</div>
					<div class="stance">{post.data.stance ?? post.data.description}</div>
					<div class="age">
						<time datetime={post.data.pubDate.toISOString()}>{formatPubDate(post.data.pubDate)}</time>
						{views.counts[post.id] > 0 && <span class="vw">{formatViews(views.counts[post.id])} views</span>}
					</div>
				</a>
			))}
		</div>
	)
}

<style>
	/* PC: .meta는 상자 없이 칸 둘(CATEGORY · LAYERS)로 풀린다 */
	.meta {
		display: contents;
	}
	.cat {
		color: var(--dim);
		font: 13px/1.9 var(--mono);
	}
	.tbl {
		border-top: 1px solid var(--line);
	}
	.tr {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) 72px 216px minmax(0, 1.4fr) 80px;
		gap: 18px;
		align-items: start;
		padding: 16px 8px;
		border-bottom: 1px solid var(--line);
	}
	.th {
		padding: 8px;
		color: var(--dim);
		font: 12px var(--mono);
		letter-spacing: 0.06em;
	}
	a.tr:hover {
		background: var(--hover);
	}
	.name {
		color: var(--hi);
		font-weight: 600;
		line-height: 1.5;
	}
	.name small {
		display: block;
		margin-top: 4px;
		color: var(--dim);
		font: 400 12px var(--mono);
	}
	.pin {
		margin-right: 8px;
		padding: 0 5px;
		border: 1px solid var(--acc);
		border-radius: 3px;
		color: var(--acc);
		font: 400 11px var(--mono);
		vertical-align: 2px;
	}
	.tags {
		display: inline-flex;
		flex-wrap: wrap;
		gap: 4px 6px;
	}
	.tg {
		padding: 1px 7px;
		border: 1px solid var(--line);
		border-radius: 3px;
		color: var(--dim);
		font: 12px/1.5 var(--mono);
		white-space: nowrap;
	}
	.stance {
		padding-left: 12px;
		border-left: 2px solid var(--line);
		color: var(--tx);
		font-size: 14px;
	}
	.age {
		color: var(--dim);
		font: 12px var(--mono);
		text-align: right;
	}
	.vw {
		display: block;
		margin-top: 2px;
		font-size: 11px;
	}
	.empty {
		padding: 16px 8px;
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}
	@media (max-width: 720px) {
		.tr {
			grid-template-columns: 1fr 80px;
			gap: 8px 10px;
			padding: 16px 4px;
		}
		.th {
			display: none;
		}
		/* 모바일: 둘째 줄에 카테고리 · 레이어 나란히 */
		.meta {
			display: flex;
			flex-wrap: wrap;
			gap: 4px 10px;
			align-items: center;
			grid-column: 1 / 2;
			grid-row: 2;
		}
		.stance {
			grid-column: 1 / 3;
			grid-row: 3;
			font-size: 13px;
		}
		.age {
			grid-column: 2;
			grid-row: 1;
		}
	}
</style>
