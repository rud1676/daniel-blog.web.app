---
import { Image } from 'astro:assets';
import { formatPubDate } from '../lib/age';
import type { Post } from '../lib/posts';
import { formatViews, getViews } from '../lib/views';
import LayerRoute from './LayerRoute.astro';

/**
 * 글 목록(리스트형, prd/post-list-simple B안): 라벨 줄(PINNED · 카테고리 / 레이어) → 제목 → 날짜 · views · #태그.
 * heroImage가 있는 글만 오른쪽에 썸네일, 없으면 칸 자체를 안 그린다. 행 전체가 글 링크다.
 * description은 목록에 보이지 않는다(검색 대상으로는 쓴다).
 * views는 빌드 때 BigQuery에서 센 값(lib/views.ts) — 집계 안 한 빌드거나 0이면 안 보인다.
 * 홈·/posts·필터·검색·글 끝 "같은 레이어 글"이 같이 쓴다. JS 0.
 * 클래스 a.tr · .name · .tagline 은 src/scripts/search.ts가 찾는다.
 */
interface Props {
	posts: Post[];
	/** 글이 없을 때 보일 문장 */
	empty?: string;
}

const { posts, empty = '아직 발행한 글이 없다.' } = Astro.props;
const views = await getViews();
---

{
	posts.length === 0 ? (
		<p class="empty dim mono">{empty}</p>
	) : (
		<div class="list" role="list">
			{posts.map((post) => {
				const n = views.counts[post.id] ?? 0;
				return (
					<a class="tr" href={`/posts/${post.id}/`} role="listitem">
						<div class="txt">
							<div class="lbl">
								{post.data.pinned && <span class="pin">PINNED</span>}
								<span class="cat">{post.data.category}</span>
								{post.data.layers && (
									<>
										<span class="sl" aria-hidden="true">/</span>
										<LayerRoute layers={post.data.layers} />
									</>
								)}
							</div>
							<div class="name">{post.data.title}</div>
							<div class="sub">
								<time datetime={post.data.pubDate.toISOString()}>{formatPubDate(post.data.pubDate)}</time>
								{n > 0 && <span class="vw"> · {formatViews(n)} {n === 1 ? 'view' : 'views'}</span>}
								{post.data.tags.length > 0 && (
									<span class="tagline"> · {post.data.tags.slice(0, 2).map((tag) => `#${tag}`).join(' ')}</span>
								)}
							</div>
						</div>
						{post.data.heroImage && (
							<Image class="thumb" src={post.data.heroImage} width={352} height={220} alt="" loading="lazy" />
						)}
					</a>
				);
			})}
		</div>
	)
}

<style>
	.list {
		border-top: 1px solid var(--line);
	}
	.tr {
		display: flex;
		gap: 32px;
		align-items: center;
		padding: 22px 8px;
		border-bottom: 1px solid var(--line);
	}
	a.tr:hover {
		background: var(--hover);
	}
	.txt {
		flex: 1;
		min-width: 0;
	}
	.lbl {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 4px 6px;
		color: var(--dim);
		font: 12px/1.6 var(--mono);
	}
	/* 라벨 줄에선 레이어 칩 테두리를 빼고 색 글자만 */
	.lbl :global(.ly) {
		padding: 0;
		border: 0;
	}
	.lbl :global(.arr) {
		margin: 0 4px 0 0;
	}
	.sl {
		opacity: 0.6;
	}
	.pin {
		padding: 0 5px;
		border: 1px solid var(--acc);
		border-radius: 3px;
		color: var(--acc);
		font: 400 11px var(--mono);
	}
	.name {
		margin: 6px 0 10px;
		color: var(--hi);
		font-size: 20px;
		font-weight: 700;
		line-height: 1.4;
	}
	.sub {
		color: var(--dim);
		font: 12px var(--mono);
	}
	.thumb {
		flex: none;
		width: 176px;
		height: 110px;
		border: 1px solid var(--line);
		border-radius: 6px;
		object-fit: cover;
	}
	.empty {
		padding: 16px 8px;
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}
	@media (max-width: 720px) {
		.tr {
			gap: 14px;
			padding: 18px 4px;
		}
		.name {
			font-size: 17px;
		}
		.thumb {
			width: 96px;
			height: 64px;
		}
	}
</style>
