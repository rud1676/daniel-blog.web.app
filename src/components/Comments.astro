---
/*
  글 끝 댓글 — giscus(GitHub Discussions). 버튼 없이, 댓글 자리가 화면 가까이 오면 giscus.app/client.js를
  바로 불러온다 (2026-11-12 버튼 제거) → 글 상세 JS 예산(≤ 10kB)에는 이 작은 로더만 들어간다.
  - 저장소: 이 레포의 Discussions, 카테고리 Announcements(방문자는 댓글만, 새 토론은 giscus가 만든다)
  - 글 ↔ 토론 매핑: pathname (도메인이 바뀌어도 이어진다)
  - 테마: html[data-theme]를 따라가고, 토글하면 iframe에도 알린다
  레포·카테고리 ID는 공개값이다(페이지 HTML에 그대로 나간다).
*/
const GISCUS = {
	repo: 'rud1676/daniel-blog.web.app',
	repoId: 'R_kgDOU-HlRg',
	category: 'Announcements',
	categoryId: 'DIC_kwDOU-HlRs4DKR7J',
};
/** 제목·안내만 바꿔 다른 페이지(/cli 등)에도 단다. 토론은 pathname별로 따로 생긴다 */
interface Props {
	title?: string;
	note?: string;
}
const { title = '댓글', note = 'GitHub 계정으로 남길 수 있어요.' } = Astro.props;
---

<section class="cm" aria-labelledby="comments" data-giscus={JSON.stringify(GISCUS)}>
	<h2 id="comments" class="sec">{title}</h2>
	<div class="slot">
		{note && <p class="dim note">{note}</p>}
		<noscript>
			<p class="dim note">
				JavaScript가 꺼져 있어요. <a href={`https://github.com/${GISCUS.repo}/discussions`}>GitHub Discussions</a>에서 볼 수 있어요.
			</p>
		</noscript>
	</div>
</section>

<script is:inline>
	(function(){var box=document.querySelector('[data-giscus]');if(!box)return;var c=JSON.parse(box.dataset.giscus),d=document.documentElement,th=function(){return d.dataset.theme=='light'?'light':'dark'},done=false;function load(){if(done)return;done=true;var s=document.createElement('script'),a={src:'https://giscus.app/client.js','data-repo':c.repo,'data-repo-id':c.repoId,'data-category':c.category,'data-category-id':c.categoryId,'data-mapping':'pathname','data-strict':'1','data-reactions-enabled':'1','data-emit-metadata':'0','data-input-position':'top','data-theme':th(),'data-lang':'ko','data-loading':'lazy',crossorigin:'anonymous',async:''};for(var k in a)s.setAttribute(k,a[k]);box.querySelector('.slot').replaceChildren(s)}
	// 화면 아래 300px 안으로 들어오면 불러온다 (그 전에는 외부 스크립트 0)
	if('IntersectionObserver' in window){var io=new IntersectionObserver(function(es){if(es.some(function(e){return e.isIntersecting})){io.disconnect();load()}},{rootMargin:'300px'});io.observe(box)}else load()
	new MutationObserver(function(){var f=document.querySelector('iframe.giscus-frame');f&&f.contentWindow.postMessage({giscus:{setConfig:{theme:th()}}},'https://giscus.app')}).observe(d,{attributes:true,attributeFilter:['data-theme']})})();
</script>

<style>
	.cm {
		margin: 40px 0 0;
		padding-top: 8px;
		border-top: 1px solid var(--line);
	}
	.sec {
		margin: 16px 0 12px;
		color: var(--hi);
		font: 600 15px var(--sans);
	}
	.note {
		margin: 10px 0 0;
		font-size: 13px;
	}
	.note a {
		color: var(--front);
		text-decoration: underline;
	}
	/* giscus iframe이 들어온 뒤 */
	.slot :global(.giscus-frame) {
		width: 100%;
		border: 0;
	}
</style>
