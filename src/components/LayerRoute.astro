---
import type { Layer } from '../lib/layers';

/** 레이어 칩, 쉼표로 나열 (2026-11-06 화살표 → 쉼표: 순서에 뜻을 싣지 않는다). 칩 색은 tokens.css의 --<레이어>. */
interface Props {
	layers: readonly Layer[];
}

const { layers } = Astro.props;
---

<span class="route">
	{
		layers.map((layer, i) => (
			<>
				{i > 0 && (
					<span class="arr" aria-hidden="true">
						,
					</span>
				)}
				<span class="ly" style={`color: var(--${layer})`}>
					{layer}
				</span>
			</>
		))
	}
</span>

<style>
	.route {
		display: inline-flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 2px 0;
	}
	.ly {
		display: inline-block;
		padding: 1px 7px;
		border: 1px solid currentColor;
		border-radius: 3px;
		font: 12px/1.5 var(--mono);
		white-space: nowrap;
	}
	.arr {
		margin: 0 5px 0 1px;
		color: var(--dim);
		font: 12px var(--mono);
	}
</style>
