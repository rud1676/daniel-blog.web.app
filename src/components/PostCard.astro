---
import FormattedDate from './FormattedDate.astro';
import type { Post } from '../lib/posts';

interface Props {
	post: Post;
}

const { post } = Astro.props;
---

<article class="card">
	<a href={`/posts/${post.id}/`}>
		<h3 class="title">{post.data.title}</h3>
		<p class="description">{post.data.description}</p>
	</a>
	<div class="meta">
		<FormattedDate date={post.data.pubDate} />
		{
			post.data.tags.length > 0 && (
				<span class="tags">
					{post.data.tags.map((tag) => (
						<a href={`/tags/${tag}/`}>#{tag}</a>
					))}
				</span>
			)
		}
	</div>
</article>

<style>
	.card {
		padding: 1.25em 0;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.card > a {
		display: block;
		text-decoration: none;
	}
	.title {
		margin: 0 0 0.3em 0;
		color: rgb(var(--black));
		font-size: 1.3em;
		line-height: 1.3;
	}
	.card > a:hover .title {
		color: rgb(var(--accent));
	}
	.description {
		margin: 0;
		color: rgb(var(--gray-dark));
		font-size: 0.95em;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75em;
		margin-top: 0.6em;
		color: rgb(var(--gray));
		font-size: 0.85em;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
	}
	.tags a {
		color: rgb(var(--gray));
		text-decoration: none;
	}
	.tags a:hover {
		color: rgb(var(--accent));
	}
</style>
