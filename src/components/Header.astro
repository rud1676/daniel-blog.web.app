---
/** 현재 위치 표시용. /posts/… 아래는 전부 posts로 본다.
 *  rss·github 링크는 헤더에 두지 않고 /about 의 Links에 둔다. */
const section = Astro.url.pathname.split('/')[1] ?? '';
const nav = [
	{ href: '/posts', label: 'posts', key: 'posts' },
	// 검색은 /search 페이지에만 JS가 있다. 헤더는 링크뿐이라 다른 페이지의 JS 0은 그대로다. 단축키(/)는 두지 않는다.
	{ href: '/search', label: 'search', key: 'search' },
	{ href: '/cli', label: 'cli', key: 'cli' },
	// projects는 임시로 메뉴에서 뺐다(2026-11-05). 페이지(/projects, /projects/list)는 그대로 있다.
	// { href: '/projects', label: 'projects', key: 'projects' },
	{ href: '/about', label: 'about', key: 'about' },
];
---

<header class="top">
	<div class="wrap">
		<a href="/" class="prompt" aria-label="홈"><span class="led" aria-hidden="true"></span>daniel@blog<b>:~</b>$</a>
		<span class="ctx dim">ctx: infra-first</span>
		<nav aria-label="주 메뉴">
			{
				nav.map(({ href, label, key }) => (
					<a href={href} class:list={{ on: section === key }} aria-current={section === key ? 'page' : undefined}>
						{label}
					</a>
				))
			}
			<button type="button" class="theme" data-theme-toggle title="기본값: OS 설정">
				theme: <span class="t-dark">dark</span> / <span class="t-light">light</span>
			</button>
		</nav>
	</div>
</header>

<style>
	.top {
		border-bottom: 1px solid var(--line);
		background: var(--bg2);
	}
	.top .wrap {
		display: flex;
		align-items: center;
		gap: 20px;
		height: 48px;
		font: 13px var(--mono);
	}
	.prompt {
		color: var(--ok);
		white-space: nowrap;
	}
	.prompt b {
		color: var(--acc);
		font-weight: 400;
	}
	.led {
		display: inline-block;
		width: 8px;
		height: 8px;
		margin-right: 8px;
		border-radius: 50%;
		background: var(--ok);
		box-shadow: 0 0 8px var(--ok);
	}
	nav {
		display: flex;
		align-items: center;
		gap: 18px;
		margin-left: auto;
		color: var(--dim);
	}
	nav a:hover,
	nav a.on {
		color: var(--hi);
	}
	nav a.on::before {
		content: '› ';
		color: var(--acc);
	}
	.theme {
		margin-left: 14px;
		padding: 3px 8px;
		border: 1px solid var(--line);
		border-radius: 6px;
		background: none;
		color: var(--dim);
		font: 12px var(--mono);
		white-space: nowrap;
		cursor: pointer;
	}
	/* 지금 테마를 굵게. JS 없이 OS 설정만 따를 때는 둘 다 보통 굵기 */
	:global(html[data-theme='dark']) .t-dark,
	:global(html[data-theme='light']) .t-light {
		color: var(--hi);
		font-weight: 600;
	}
	@media (max-width: 720px) {
		.top .wrap {
			flex-wrap: wrap;
			row-gap: 6px;
			height: auto;
			padding-top: 8px;
			padding-bottom: 8px;
			font-size: 12px;
		}
		.ctx {
			display: none;
		}
		nav {
			flex-wrap: wrap;
			gap: 10px;
			font-size: 12px;
		}
		.theme {
			margin-left: 0;
			padding: 2px 6px;
		}
	}
</style>
