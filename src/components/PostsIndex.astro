---
import { type Category, categoryOf } from '../lib/categories';
import { type Layer } from '../lib/layers';
import { getCategoryCounts, getLayerCounts, type Post } from '../lib/posts';
import PostTable from './PostTable.astro';

/**
 * /posts · /posts/layer/<레이어> · /posts/category/<카테고리> 가 같이 쓰는 화면.
 * 탭·칩은 버튼이 아니라 미리 빌드한 정적 페이지로 가는 링크다 → JS 0.
 * 글이 0편인 카테고리·레이어는 탭·칩도 페이지도 만들지 않는다 (getCategoryCounts · getLayerCounts).
 * 카테고리 페이지에선 레이어 칩 숫자만 그 카테고리 기준으로 센다. 칩 링크는 전체 기준 레이어 페이지 (조합 필터는 없다).
 */
interface Props {
	/** 발행 글 전체 (탭 숫자용) */
	all: Post[];
	/** 지금 고른 레이어. layer · category 중 하나만 */
	layer?: Layer;
	/** 지금 고른 카테고리 */
	category?: Category;
}

const { all, layer, category } = Astro.props;
const base = category ? all.filter((post) => post.data.category === category) : all;
const shown = layer ? base.filter((post) => post.data.layers?.includes(layer)) : base;
const cats = getCategoryCounts(all);
const counts = getLayerCounts(base);
const allHref = category ? `/posts/category/${category}` : '/posts';
---

<h1 class="sec">
	{layer ? <>{layer}를 거친 글</> : category ?? '전체 글'} <span class="dim">{shown.length}</span>
</h1>

{
	all.length > 0 && (
		<nav class="cats mono" aria-label="카테고리">
			<span class="dim">~/posts</span>
			<a href="/posts" class:list={{ on: !category }} aria-current={!category && !layer ? 'page' : undefined}>
				all<span class="n">{all.length}</span>
			</a>
			{cats.map(({ category: c, count }) => (
				<a href={`/posts/category/${c}`} class:list={{ on: c === category }} aria-current={c === category ? 'page' : undefined}>
					{c}
					<span class="n">{count}</span>
				</a>
			))}
		</nav>
	)
}

{category && <p class="desc dim mono">{category} — {categoryOf(category).description}</p>}

{
	base.length > 0 && (
		<nav class="filters" aria-label="영역 필터">
			<a href={allHref} class:list={['ly', { on: !layer }]} style="color: var(--hi)" aria-current={!layer && category ? 'page' : undefined}>
				all {base.length}
			</a>
			{counts.map(({ layer: l, count }) => (
				<a
					href={`/posts/layer/${l}`}
					class:list={['ly', { on: l === layer }]}
					style={`color: var(--${l})`}
					aria-current={l === layer ? 'page' : undefined}
				>
					{l} {count}
				</a>
			))}
		</nav>
	)
}

<PostTable posts={shown} />

<style>
	.sec {
		margin: 4px 0 12px;
		color: var(--hi);
		font: 600 15px var(--sans);
	}
	.sec .dim {
		margin-left: 4px;
		font-weight: 400;
	}
	.cats {
		display: flex;
		gap: 18px;
		align-items: baseline;
		margin: 0 0 12px;
		overflow-x: auto;
		font-size: 14px;
		white-space: nowrap;
	}
	.cats a {
		padding-bottom: 3px;
		border-bottom: 2px solid transparent;
		color: var(--dim);
	}
	.cats a:hover {
		color: var(--hi);
	}
	.cats a.on {
		border-color: var(--ok);
		color: var(--hi);
	}
	.cats .n {
		margin-left: 4px;
		color: var(--dim);
	}
	.desc {
		margin: -4px 0 14px;
		font-size: 13px;
	}
	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 0 0 14px;
	}
	.ly {
		display: inline-block;
		padding: 1px 7px;
		border: 1px solid currentColor;
		border-radius: 3px;
		font: 12px/1.5 var(--mono);
		white-space: nowrap;
	}
	/* 목업은 안 고른 칩을 opacity 0.7로 흐리게 했지만, 라이트 테마에서 대비가 4.5:1 아래로 떨어져
	   흐리기 대신 고른 칩만 배경 + 굵게 표시한다. */
	.ly:hover {
		background: var(--hover);
	}
	.ly.on {
		background: var(--chipon);
		font-weight: 600;
	}
</style>
