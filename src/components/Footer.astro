---
import { AUTHOR, GITHUB_URL } from '../consts';

const year = new Date().getFullYear();
---

<footer>
	<div class="wrap">
		<span>© {year} {AUTHOR} · built with Astro · JS ≤ 10kB on posts</span>
		<a href="/rss.xml">rss</a>
		<a href={GITHUB_URL} target="_blank" rel="noopener">github</a>
	</div>
</footer>

<style>
	footer {
		margin-top: 56px;
		padding: 22px 0 90px;
		border-top: 1px solid var(--line);
		color: var(--dim);
		font: 12px var(--mono);
	}
	.wrap {
		display: flex;
		flex-wrap: wrap;
		gap: 18px;
	}
	span {
		margin-right: auto;
	}
	a:hover {
		color: var(--hi);
	}
	@media (max-width: 720px) {
		footer {
			padding-bottom: 80px;
		}
	}
</style>
