---
import { REPO_URL } from '../consts';
import type { GitLog } from '../lib/gitlog';
import type { Layer } from '../lib/layers';

/**
 * 홈 히어로 (blog-design-2 A안): oh-my-zsh 터미널에서 친 `whoami` + `git log --oneline`.
 * git log는 이 레포의 실제 기록 — 빌드 때 src/lib/gitlog.ts 가 만든다. CSS만, JS 0.
 * PC 8줄, 모바일(≤720px) 6줄.
 */
interface Props {
	log: GitLog;
}

const { log } = Astro.props;
const SHOW = 8;
const lines = log.lines.slice(0, SHOW);
const heroLayers: Layer[] = ['front', 'server', 'infra', 'db', 'ai'];
const kindClass = { post: 'p', fix: 'f', site: 's', infra: 'i' } as const;
---

<section class="z" aria-label="소개">
	<div class="zb" aria-hidden="true"><i></i><i></i><i></i><span>daniel-blog — zsh</span><span class="zr">oh-my-zsh · robbyrussell</span></div>
	<div class="body">
		<p><span class="arw">➜</span> <span class="cwd">~</span> whoami</p>
		<p><b class="nm">Daniel</b> — 인프라를 주로 다루는, 레이어를 넘나드는 개발자</p>
		<p class="dim ind">
			{heroLayers.map((layer, i) => <>{i > 0 && ' ▸ '}<span style={`color: var(--${layer})`}>{layer}</span></>)} · 고른 것보다 버린 것과 그 이유를 남긴다
		</p>
		{
			lines.length > 0 && (
				<>
					<p class="gap">
						<span class="arw">➜</span> <span class="cwd">daniel-blog</span> <span class="gb">git:(<span class="br">{log.branch}</span>)</span> git log --oneline --date=short -{SHOW}
					</p>
					<ol class="gl" data-live-sha={lines[0].refs?.live ? log.headSha : undefined} data-live-tag={log.liveTag ?? undefined}>
						{lines.map((l) => (
							<li>
								<span class="g" aria-hidden="true">*</span> <span class="hs">{l.short}</span> <time class="dt" datetime={l.date}>{l.date}</time>{' '}
								{l.refs && (
									<>
										<span class="rf">
											(<span class="hd">{l.refs.head}</span>
											{l.refs.live && (
												<>
													, <span class="tgl">tag: live</span>
												</>
											)}
											)
										</span>{' '}
									</>
								)}
								<span class:list={['ty', kindClass[l.kind]]}>{l.kind}</span>{' '}
								{l.href.startsWith('/') ? (
									<a href={l.href} class="post">{l.text}</a>
								) : (
									<a href={l.href} class="cm" target="_blank" rel="noopener">{l.text}</a>
								)}
							</li>
						))}
					</ol>
					<p class="dim ind">
						… <a href={`${REPO_URL}/commits/main`} class="more" target="_blank" rel="noopener">git log --all 전체 보기 →</a>
					</p>
				</>
			)
		}
		<p class="gap">
			<span class="arw">➜</span> <span class="cwd">daniel-blog</span> <span class="gb">git:(<span class="br">{log.branch}</span>)</span> <span class="cur" aria-hidden="true">▌</span>
		</p>
	</div>
</section>

<style>
	.z {
		margin: 0 0 28px;
		overflow: hidden;
		border: 1px solid var(--line);
		border-radius: 8px;
		background: var(--panel);
	}
	.zb {
		display: flex;
		align-items: center;
		gap: 6px;
		padding: 10px 14px;
		border-bottom: 1px solid var(--line);
		background: var(--bg2);
		color: var(--dim);
		font: 12px var(--mono);
	}
	.zb i {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--dot);
	}
	.zb span {
		margin-left: 10px;
	}
	.zb .zr {
		margin-left: auto;
	}
	.body {
		padding: 20px 22px;
		color: var(--tx);
		font: 14px/1.75 var(--mono);
	}
	p,
	ol {
		margin: 0;
	}
	ol {
		padding: 0;
		list-style: none;
	}
	li {
		padding-left: 2ch;
		text-indent: -2ch; /* 줄바꿈되면 * 다음부터 들여쓰기 */
	}
	.gap {
		margin-top: 1.75em;
	}
	.ind {
		padding-left: 2ch;
	}
	.arw {
		color: var(--ok);
	}
	.cwd,
	.hd,
	.cur {
		color: var(--acc);
	}
	.gb {
		color: var(--front);
	}
	.br,
	.g {
		color: var(--ai);
	}
	.nm {
		color: var(--hi);
	}
	.hs,
	.rf {
		color: var(--tooling);
	}
	.dt {
		color: var(--dim);
	}
	.tgl {
		color: var(--server);
	}
	.ty {
		display: inline-block;
		min-width: 3.6em;
		font-size: 12px;
		text-indent: 0;
	}
	.ty.p {
		color: var(--server);
	}
	.ty.f {
		color: var(--warn);
	}
	.ty.s {
		color: var(--front);
	}
	.ty.i {
		color: var(--infra);
	}
	a.post,
	.more {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	a:hover {
		color: var(--hi);
	}
	a.cm:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.cur {
		animation: blink 1s steps(2) infinite;
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.cur {
			animation: none;
		}
	}
	@media (max-width: 720px) {
		.z {
			margin: 0 0 20px;
		}
		.zr {
			display: none;
		}
		.body {
			padding: 14px;
			font-size: 12px;
			line-height: 1.7;
		}
		/* 모바일은 6줄 */
		li:nth-child(n + 7) {
			display: none;
		}
	}
</style>
