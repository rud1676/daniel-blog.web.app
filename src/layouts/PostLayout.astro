---
/*
  글 상세. 읽기 우선 — 콘솔 장식은 상단 메타 박스에만 쓰고, 본문은 산세리프 17px / 행간 1.95 / 폭 720px.
  JS: 테마 인라인 스크립트 + 목차 스크립트(toc.ts)뿐. 예산 ≤ 10kB는 scripts/check-js-budget.mjs가 빌드 후 잰다.
  글 끝: "같은 레이어를 거친 글" + 댓글(giscus, 눌러야 불러옴). 수정 이력·저자 카드·이전/다음·질문하기 카드는 뺐다.
*/
import type { MarkdownHeading } from 'astro';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Comments from '../components/Comments.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import LayerRoute from '../components/LayerRoute.astro';
import PostTable from '../components/PostTable.astro';
import { categoryOf } from '../lib/categories';
import type { Post } from '../lib/posts';
import { formatViews, getViews } from '../lib/views';

interface Props {
	post: Post;
	headings: MarkdownHeading[];
	related: Post[];
	minutes: number;
}

const { post, headings, related, minutes } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, canonical, category, layers, stance, tags } = post.data;

/** 목차는 h2만. 2개 미만이면 목차를 아예 안 그린다. */
const toc = headings.filter((h) => h.depth === 2);
const showToc = toc.length >= 2;
const ymd = (d: Date) => d.toISOString().slice(0, 10);
/** 조회수 — 빌드 때 BigQuery에서 센 값. 집계를 안 하는 빌드(로컬 기본)면 줄 자체를 숨긴다 */
const views = await getViews();
const viewCount = views.counts[post.id];
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage}
			type="article"
			canonical={canonical}
			pubDate={pubDate}
			updatedDate={updatedDate}
		/>
	</head>
	<body>
		<Header />
		<div class="progress" aria-hidden="true"><i></i></div>
		<div class:list={['postwrap', { 'no-toc': !showToc }]}>
			<article class="post">
				<div class="crumb mono">
					<a href="/posts">~/posts</a> / <a href={`/posts/category/${category}`}>{category}</a> / {post.id}
				</div>
				<h1>{title}</h1>
				<div class="meta mono">
					<div>
						<b>CATEGORY</b>
						<a class="cat" href={`/posts/category/${category}`}>{category}</a> — {categoryOf(category).description}
					</div>
					{
						layers && (
							<div>
								<b>LAYERS</b>
								<LayerRoute layers={layers} />
							</div>
						)
					}
					<div>
						<b>DATE</b>
						<time datetime={pubDate.toISOString()}>{ymd(pubDate)}</time> · {minutes} min read
						{updatedDate && <> · updated <time datetime={updatedDate.toISOString()}>{ymd(updatedDate)}</time></>}
					</div>
					{
						views.updatedAt && (
							<div>
								<b>VIEWS</b>
								{viewCount ? (
									formatViews(viewCount)
								) : (
									<span class="vu">— 집계 전 (다음 06:00 빌드부터)</span>
								)}
							</div>
						)
					}
					{
						stance && (
							<div class="st-row">
								<b>STANCE</b>
								<span class="st">{stance}</span>
							</div>
						)
					}
					{tags.length > 0 && <div class="tags">{tags.map((tag) => `#${tag}`).join(' ')}</div>}
				</div>
				{heroImage && <Image class="hero" width={1020} height={510} src={heroImage} alt="" />}

				<div class="body">
					<slot />
				</div>

				{
					related.length > 0 && (
						<section class="pe" aria-labelledby="related">
							<h2 id="related" class="sec">
								같은 레이어를 거친 글
							</h2>
							<PostTable posts={related} headless />
						</section>
					)
				}
				<Comments />
			</article>

			{
				showToc && (
					<aside class="side">
						<div class="sidein" data-toc data-minutes={minutes}>
							<small class="mono dim">ON THIS PAGE</small>
							<nav class="toc" aria-label="목차">
								{toc.map((h) => (
									<a href={`#${h.slug}`} data-slug={h.slug}>
										{h.text}
									</a>
								))}
							</nav>
							<div class="readpct mono dim" data-readpct />
						</div>
					</aside>
				)
			}
		</div>
		<Footer />
		<script>
			import '../scripts/toc';
		</script>
	</body>
</html>

<style>
	/* 읽기 진행바: 스크롤 연동 애니메이션(animation-timeline) 지원 브라우저에서만 보인다. JS 0. */
	.progress {
		position: sticky;
		top: 0;
		z-index: 9;
		height: 2px;
	}
	.progress i {
		display: none;
		height: 2px;
		background: var(--acc);
		transform-origin: 0 50%;
	}
	@supports (animation-timeline: scroll()) {
		.progress i {
			display: block;
			animation: read-progress linear both;
			animation-timeline: scroll(root);
		}
	}
	@keyframes read-progress {
		from {
			transform: scaleX(0);
		}
		to {
			transform: scaleX(1);
		}
	}

	.postwrap {
		display: grid;
		grid-template-columns: minmax(0, 720px) 220px;
		gap: 40px;
		justify-content: center;
		padding: 0 24px;
	}
	.postwrap.no-toc {
		grid-template-columns: minmax(0, 720px);
	}
	.post {
		padding-top: 40px;
	}
	.crumb {
		color: var(--dim);
		font-size: 13px;
	}
	.crumb a {
		color: var(--acc);
	}
	.meta .cat {
		color: var(--tx);
	}
	.meta .cat:hover {
		color: var(--hi);
	}
	h1 {
		margin: 14px 0 18px;
		color: var(--hi);
		font-size: 32px;
		line-height: 1.35;
		letter-spacing: -0.01em;
	}
	.meta {
		padding: 14px 16px;
		border: 1px solid var(--line);
		border-radius: 6px;
		background: var(--panel);
		color: var(--dim);
		font-size: 13px;
		line-height: 1.9;
	}
	.meta b {
		display: inline-block;
		width: 78px;
		color: var(--acc);
		font-weight: 400;
	}
	.meta .vu {
		color: var(--dim);
	}
	.st-row {
		display: flex;
		gap: 6px;
	}
	.st-row b {
		flex: none;
	}
	.st {
		color: var(--hi);
		font: 14px/1.6 var(--sans);
	}
	.tags {
		margin-top: 4px;
		font-size: 12px;
	}
	.hero {
		display: block;
		width: 100%;
		margin-top: 24px;
		border-radius: 8px;
	}

	/* 본문 — 마크다운이 만든 태그라 :global 로 건다 */
	.body {
		margin-top: 8px;
		color: var(--body);
		font-size: 17px;
		line-height: 1.95;
	}
	.body :global(h2) {
		margin: 44px 0 12px;
		color: var(--hi);
		font-size: 22px;
		scroll-margin-top: 16px;
	}
	.body :global(h3) {
		margin: 32px 0 10px;
		color: var(--hi);
		font-size: 18px;
		scroll-margin-top: 16px;
	}
	.body :global(p) {
		margin: 0 0 18px;
	}
	.body :global(a) {
		color: var(--front);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.body :global(strong) {
		color: var(--hi);
	}
	.body :global(ul),
	.body :global(ol) {
		padding-left: 22px;
	}
	.body :global(li) {
		margin-bottom: 8px;
	}
	.body :global(blockquote) {
		margin: 0 0 18px;
		padding: 2px 16px;
		border-left: 3px solid var(--line);
		color: var(--dim);
	}
	/* 인용문 안 마지막 문단의 아래 여백(p 공통 18px) 때문에 글이 위로 쏠려 보이지 않게 */
	.body :global(blockquote > :last-child) {
		margin-bottom: 0;
	}
	.body :global(:not(pre) > code) {
		padding: 1px 6px;
		border-radius: 4px;
		background: var(--panel2);
		color: var(--acc);
		font-size: 15px;
	}
	.body :global(pre) {
		margin: 0 0 22px;
		padding: 14px 16px;
		overflow: auto;
		border: 1px solid var(--line);
		border-radius: 6px;
		background: var(--panel) !important;
		font: 14px/1.7 var(--mono);
	}
	.body :global(table) {
		width: 100%;
		margin: 0 0 22px;
		border-collapse: collapse;
		font-size: 15px;
	}
	.body :global(th),
	.body :global(td) {
		padding: 6px 10px;
		border: 1px solid var(--line);
		text-align: left;
	}
	.body :global(th) {
		background: var(--panel);
		color: var(--hi);
	}
	.body :global(img) {
		border-radius: 6px;
	}
	.body :global(hr) {
		margin: 32px 0;
	}

	.pe {
		margin: 56px 0 0;
		padding-top: 8px;
		border-top: 1px solid var(--line);
	}
	.sec {
		margin: 16px 0 12px;
		color: var(--hi);
		font: 600 15px var(--sans);
	}

	.side {
		padding-top: 150px;
	}
	.sidein {
		position: sticky;
		top: 90px;
	}
	.toc {
		margin: 8px 0 12px;
		padding-left: 14px;
		border-left: 2px solid var(--line);
		color: var(--dim);
		font-size: 14px;
	}
	.toc a {
		display: block;
		padding: 2px 0;
	}
	.toc a:hover {
		color: var(--hi);
	}
	/* toc.ts가 지금 읽는 절에 .on을 붙인다 */
	.toc a:global(.on) {
		margin-left: -16px;
		padding-left: 14px;
		border-left: 2px solid var(--acc);
		color: var(--hi);
	}
	.readpct {
		font-size: 12px;
	}

	@media (max-width: 960px) {
		.postwrap {
			grid-template-columns: minmax(0, 720px);
		}
		.side {
			display: none;
		}
	}
	@media (max-width: 720px) {
		.postwrap {
			padding: 0 16px;
		}
		h1 {
			font-size: 25px;
		}
		.body {
			font-size: 16px;
		}
	}
</style>
